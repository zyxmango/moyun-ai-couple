# 应用安全：部署前请替换为足够长的随机字符串
SECRET_KEY=replace-with-a-long-random-secret

# SQLite 默认保存在 backend/data/couple_app.db
DATABASE_URL=sqlite:///./data/couple_app.db

# OpenAI 兼容接口；留空时 AI 功能使用本地降级逻辑，便于演示
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# QQ 邮箱 SMTP。填写邮箱地址和 SMTP 授权码，不是 QQ 登录密码
SMTP_EMAIL=
SMTP_AUTH_CODE=

# 本地开发启动配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false

# 管理员手机号
ADMIN_PHONE=13800000000
