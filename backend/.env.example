# 应用安全：部署前请替换为足够长的随机字符串
SECRET_KEY=replace-with-a-long-random-secret

# SQLite 默认保存在 backend/data/couple_app.db
DATABASE_URL=sqlite:///./data/couple_app.db
# Docker Compose 会覆盖为 PostgreSQL + pgvector；生产环境请使用独立强密码。

# 阿里云百炼 OpenAI 兼容接口；留空 API Key 时使用本地降级逻辑
AI_API_KEY=
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.8-max
AI_EMBEDDING_MODEL=text-embedding-v3
# 长期记忆抽取属于结构化任务，关闭深度思考可显著降低延迟和 token 消耗
AI_ENABLE_THINKING=false
# 正式记忆默认直接使用已抽取的结构化事实，不再额外调用一次模型润色
AI_MEMORY_SUMMARY_WITH_MODEL=false
# 可选：填写供应商单价后，管理端会估算长期记忆任务成本（美元/百万 Token）
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_EMBEDDING_COST_PER_MILLION=0

# API 与记忆同步解耦。默认由 python -m app.memory_worker 独立处理。
MEMORY_WORKER_IN_PROCESS=false
MEMORY_WORKER_POLL_SECONDS=2
MEMORY_JOB_LEASE_SECONDS=600

# QQ 邮箱 SMTP。填写邮箱地址和 SMTP 授权码，不是 QQ 登录密码
SMTP_EMAIL=
SMTP_AUTH_CODE=

# 本地开发启动配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false

# 管理员手机号
ADMIN_PHONE=13800000000

# 文件存储。local 使用 backend/data/uploads；s3 支持 AIStor/S3/OSS/COS。
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=couple-private
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=3600
